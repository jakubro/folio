{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts",
    "src/client/page.ts",
    "src/client/theme.ts",
    "src/client/snapshot.ts",
    "src/server/yaml-worker.ts",
    "src/server/sqlite-reader.ts",
    "src/server/draw-worker.ts",
    "test/*.test.ts",
    "test/*-worker.ts",
    "e2e/*.test.ts"
  ],
  "project": ["*.mjs", "src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "visual/**/*.ts"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "@fontsource/arimo",
    "@fontsource/jetbrains-mono",
    "highlight.js",
    "katex"
  ]
}
